    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖动以提亮或压暗相应色调。沿底部拖动分隔线可调整各区域覆盖的色调范围。"
          }
        }
      }
    },
